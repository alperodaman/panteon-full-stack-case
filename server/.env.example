# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://panteon:panteon@localhost:5432/panteon_leaderboard?schema=public"

# MongoDB connection string used by Mongoose
MONGO_URI="mongodb://panteon:panteon@localhost:27017/panteon_leaderboard?authSource=admin"

# Redis connection string used by ioredis / BullMQ / rate-limit-redis
REDIS_URL="redis://localhost:6379"

# Secret used to sign/verify JWT access tokens
JWT_SECRET="change-me-in-production"

# JWT access token expiry (e.g. 15m, 1h, 7d). Defaults to 2h if unset -- a
# deliberate demo/review convenience (no refresh-token flow exists yet);
# production should use 15m + a refresh token instead.
JWT_EXPIRY="2h"

# Port the Express server listens on
PORT=3000

# Runtime environment (development | test | production)
NODE_ENV=development
