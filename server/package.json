{
  "name": "panteon-leaderboard-server",
  "version": "0.1.0",
  "private": true,
  "description": "Panteon Full Stack Case - Leaderboard system server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-lua.js",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node --transpile-only src/scripts/seed.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.6.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^6.0.2",
    "prisma": "^7.9.1",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "allowScripts": {
    "@prisma/client@7.9.1": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.1": true
  }
}
